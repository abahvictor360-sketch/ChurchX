# ─── Supabase (required) ──────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — never
# prefix with NEXT_PUBLIC_. Used only for staff invitations and the dev seed.
SUPABASE_SECRET_KEY=

# ─── App ──────────────────────────────────────────────────────────────
# Public URL of the app, used in auth email links. On Vercel this falls back
# to the production URL automatically if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Development only ────────────────────────────────────────────────
# Seeding is refused unless this is exactly 1. Never set in production.
# CHURCHX_ALLOW_SEED=1
# SEED_PASSWORD=ChurchX-demo-2026
# SEED_EMAIL_DOMAIN=demo.churchx.app

# Database tests: a PostgreSQL 15+ server where a throwaway DB may be created.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
